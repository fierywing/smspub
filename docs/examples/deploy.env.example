# 此文件只放 Compose 参数，不放通知密钥；应用配置在 conf/config.json。
# 将 IMAGE 改为已构建的本地标签，或已核对的仓库镜像摘要。
SMSPUB_IMAGE=smspub-local:REPLACE_WITH_REVISION
SMSPUB_BIND_IP=127.0.0.1
SMSPUB_PORT=8080
# 改为实际运行身份，并使 conf/、data/ 的属主与它一致。
SMSPUB_UID=1000
SMSPUB_GID=1000
# 从 stat -Lc '%g' /dev/serial/by-path/实际AT口 获取，不能盲用 20。
SMSPUB_SERIAL_GID=REPLACE_WITH_DEVICE_GID
